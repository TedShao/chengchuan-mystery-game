{
  "name": "chengchuan-rebuild",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*domain.test.mjs",
    "test:opening": "node tests/rebuild-opening.cjs",
    "verify:build": "node scripts/build.mjs && node scripts/validate-artifact.mjs",
    "test:lesson": "node tests/first-lesson.cjs",
    "test:feedback": "node tests/report-feedback.cjs",
    "test:choices": "node tests/report-choice.cjs",
    "test:chapter-one": "node tests/chapter-one-probe.cjs",
    "test:narrative": "node tests/report-narrative.cjs",
    "test:recovery": "node tests/new-player-recovery.cjs",
    "test:morning": "node tests/day-two-observer.cjs && node tests/morning-branches.cjs",
    "test:background": "node tests/opening-context.cjs && node tests/opening-novice.cjs",
    "test:thanks": "node tests/reply-opening.cjs && node tests/thanks-experiment.cjs && node tests/thanks-curiosity.cjs",
    "build:pages": "node scripts/build-pages.mjs && node scripts/validate-pages.mjs",
    "test:pages": "node tests/pages-navigation.cjs && npm run test:thanks && node tests/morning-branches.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
